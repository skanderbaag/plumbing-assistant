# Names of the environment variables this app needs. Real values live in
# Vercel (Project -> Settings -> Environment Variables), never in the repo.

# Already set today
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
HOUSECALL_API_KEY=

# Added in Milestone 1 (security hardening)
SESSION_SECRET=   # signs login tokens; random, 64 hex chars
PIN_PEPPER=       # mixed into PIN hashes; random, 64 hex chars; if lost, every PIN must be reset

# Added later, for the scheduled Office agents
CRON_SECRET=
